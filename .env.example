# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA coloque valores reais neste arquivo nem faça commit do .env.local.

# --- Supabase (Painel do projeto > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: usada só no servidor (rotina diária, backup, criação de usuários)
SUPABASE_SERVICE_ROLE_KEY=

# --- Endereço público do sistema (usado nos links de "esqueci minha senha") ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Rotina diária (Vercel Cron) ---
# Texto aleatório longo; a Vercel envia no cabeçalho Authorization
CRON_SECRET=

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_REMETENTE=contato@movcode.com.br
EMAIL_RESPONDER_PARA=contato@movcode.com.br

# --- Lembretes ---
# "log" = só registra (padrão em desenvolvimento) | "real" = envia de verdade
LEMBRETES_MODO=log

# --- Dados de pagamento que vão nas mensagens ---
PAGAMENTO_PIX_CHAVE=
PAGAMENTO_PIX_NOME=

# --- Backup ---
# E-mail que recebe o backup mensal
BACKUP_EMAIL_DESTINO=contato@movcode.com.br
